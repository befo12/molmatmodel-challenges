&CONTROL
   verbosity        = 'low'
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'calc'
   pseudo_dir       = '/home/berfin/challenges/Challenge_II_8/H_on_C8'
/
&SYSTEM
   ecutwfc          = 120
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   nspin            = 2
   vdw_corr         = 'DFT-D3'
   dftd3_version    = 4
   starting_magnetization(1) = 1.0
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
H  1.008 H.upf

K_POINTS automatic
1 1 1  0 0 0

CELL_PARAMETERS angstrom
10.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 10.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 10.00000000000000

ATOMIC_POSITIONS angstrom
H  5.0000000000 5.0000000000 5.0000000000  

