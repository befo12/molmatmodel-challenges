&CONTROL
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'x'
   pseudo_dir       = '/home/berfin/molmatmodel-challenges/Challenge_II_8/Hg_on_C18'
/
&SYSTEM
   ecutwfc          = 80
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   nspin            = 1
   vdw_corr         = 'DFT-D3'
   dftd3_version    = 4
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-10
   mixing_beta      = 0.3
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Hg 200.592 Hg.upf

K_POINTS automatic
3 3 1  0 0 0

CELL_PARAMETERS angstrom
10.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 10.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 10.00000000000000

ATOMIC_POSITIONS angstrom
Hg 5.0000000000 5.0000000000 5.0000000000  

