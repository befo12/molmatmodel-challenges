&CONTROL
   calculation      = 'scf'
   outdir           = './tmp'
   pseudo_dir       = '/usr/share/espresso/pseudo'
/
&SYSTEM
   ecutwfc          = 40
   ecutrho          = 160
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Si 28.085 Si.pz-vbc.UPF

K_POINTS automatic
2 2 2  0 0 0

CELL_PARAMETERS angstrom
0.00000000000000 2.71490000000000 2.71490000000000
2.71490000000000 0.00000000000000 2.71490000000000
2.71490000000000 2.71490000000000 0.00000000000000

ATOMIC_POSITIONS angstrom
Si 1.3574500000 4.0723500000 4.0723500000  
Si 0.0000000000 0.0000000000 0.0000000000  

